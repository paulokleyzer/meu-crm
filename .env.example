# Netlify local sem Docker: npm run setup:netlify (não sobrescreve .env.local).
# Demonstração pública e compartilhada: somente dados fictícios.
CRM_ACCESS_MODE=demo
# Origem exata sem barra final. Local Netlify: localhost:8888; externo: HTTPS.
CRM_ALLOWED_ORIGIN=http://localhost:8888
# Apenas no SEGUNDO projeto Netlify, defina true quando decidir publicar.
# Ausente/false: build.ignore pula builds automáticos desta branch.
CRM_DEPLOY_V2=false
# Somente se CRM_ACCESS_MODE=basic. Não use NEXT_PUBLIC_* para credenciais.
CRM_BASIC_USER=
CRM_BASIC_PASSWORD=
# Somente VPS/PostgreSQL nativo; o Netlify fornece NETLIFY_DB_URL pelo SDK.
# Não defina manualmente NETLIFY_DB_URL/NETLIFY_DB_DRIVER no site hospedado.
POSTGRES_PASSWORD=
DATABASE_URL=
# Exclusivamente banco local/CI de testes.
TEST_DATABASE_URL=
CRM_E2E_ALLOW_RESET=false
