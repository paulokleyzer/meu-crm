# Gere .env.local com npm run setup:local ou preencha os valores com segurança.
# Não use estas marcações como senhas reais.
POSTGRES_PASSWORD=
DATABASE_URL=
# Testes de integração usam schemas isolados; nunca apontar para produção.
TEST_DATABASE_URL=
CRM_BASIC_USER=
# Pelo menos 16 caracteres; permanece exclusivamente no servidor.
CRM_BASIC_PASSWORD=
# Origem exata, sem barra final. Acesso externo exige https://.
CRM_ALLOWED_ORIGIN=http://127.0.0.1:3000
# Somente em banco local/CI descartável. Permite reset por fixture dos testes E2E.
CRM_E2E_ALLOW_RESET=false
