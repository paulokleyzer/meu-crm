# Netlify local sem Docker: npm run setup:netlify.
# VPS/PostgreSQL nativo: npm run setup:local.
# Não use estas marcações como senhas reais.
# Somente VPS/nativo: o Netlify fornece NETLIFY_DB_URL pelo SDK.
# Não defina manualmente NETLIFY_DB_URL/NETLIFY_DB_DRIVER no projeto hospedado.
POSTGRES_PASSWORD=
DATABASE_URL=
# Testes de integração usam schemas isolados; nunca apontar para produção.
TEST_DATABASE_URL=
CRM_BASIC_USER=
# Pelo menos 16 caracteres; permanece exclusivamente no servidor.
CRM_BASIC_PASSWORD=
# Origem exata, sem barra final. Acesso externo exige https://.
# Netlify Dev: http://localhost:8888. Hospedado: URL HTTPS do NOVO projeto.
CRM_ALLOWED_ORIGIN=http://localhost:8888
# Somente em banco local/CI descartável. Permite reset por fixture dos testes E2E.
CRM_E2E_ALLOW_RESET=false
